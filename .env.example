# SAGE Framework — environment template.
# Copy to `.env` and fill in the values you need. `.env` is gitignored; never
# commit real keys. Credentials are read only from the environment / .env
# (via python-dotenv) — no keys live in code.

# ── Provider API keys (fill only the ones you use) ───────────────────────────
# Real hosted APIs are reached through litellm using these standard env vars.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini accepts either name (GOOGLE_API_KEY preferred; GEMINI_API_KEY also read).
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Local open-weights (Ollama) ──────────────────────────────────────────────
# No key required; just the server endpoint (default shown).
OLLAMA_HOST=http://localhost:11434

# ── Backend / model selection (optional convenience defaults) ────────────────
# Experiments select a backend explicitly via --backend {litellm|ollama|simulator}.
SAGE_BACKEND=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ── Optional: LangSmith observability ────────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sage-framework

# ── Reproducibility ──────────────────────────────────────────────────────────
# Pin Python's hash salt so simulator RNG seeding is stable across processes.
PYTHONHASHSEED=0
